# Must resolve to the Pi from every phone; keep this origin stable for browser saves.
PI_HOSTNAME=apertus.local
# Initial benchmark settings, not verified Pi performance claims.
APERTUS_CONTEXT_TOKENS=8192
# -1 uses the CPUs available to llama.cpp; set a positive count to reserve cores.
APERTUS_THREADS=-1
LAYA_THREADS=1
APERTUS_TIMEOUT_MS=600000
PLANNER_TIMEOUT_MS=1200000

# Optional: make run-external uses a separately managed local server or HF.
# Set LLM_NAME to the exact model ID/alias served by that endpoint.
# LLM_NAME=apertus-v1.5-8b-text
# APERTUS_PROVIDER=local
# APERTUS_LOCAL_RUNTIME=llamacpp
# APERTUS_LOCAL_BASE_URL=http://host.docker.internal:43101/v1
# Ollama: runtime=ollama, URL=http://host.docker.internal:11434/v1,
# and LLM_NAME must match the model name installed in Ollama.
# MLX (Apple Silicon only): runtime=mlx, with its MLX model ID as LLM_NAME.
# For external servers, set APERTUS_CONTEXT_TOKENS above to their actual capacity,
# or leave it blank to avoid imposing the bundled model's context bound.
# Hugging Face instead: OFFLINE=false, APERTUS_PROVIDER=huggingface,
# LLM_NAME=<served-model-id>, HF_TOKEN=<private-token>.
# APERTUS_HF_BASE_URL=https://router.huggingface.co/v1
# LLM_BASE_URL overrides either provider's URL; leave unset when switching.
