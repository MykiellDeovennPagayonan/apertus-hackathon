# Server-only. local | huggingface. Restart Next.js after changing.
APERTUS_PROVIDER=local
APERTUS_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
APERTUS_LOCAL_MODEL=m1rkocasu/Apertus-v1.5-8B-text-MLX-mxfp4
# Set a model actually served by your HF provider, or use a dedicated endpoint.
APERTUS_HF_BASE_URL=https://router.huggingface.co/v1
APERTUS_HF_MODEL=
HF_TOKEN=
APERTUS_TIMEOUT_MS=120000
APERTUS_MAX_TOKENS=1024
APERTUS_MAX_CONCURRENT_REQUESTS=1
