# Server-only deployment mode. true disables accounts, MongoDB, community, and
# cloud inference; saves remain in each browser. Phones still need Pi/LAN access.
# Raspberry Pi Compose sets this at runtime; no NEXT_PUBLIC_OFFLINE flag is needed.
OFFLINE=false

# Server-only LLM selection: apertus | openai | anthropic.
# Restart Next.js after changing. Unset LLM_PROVIDER defaults to apertus.
LLM_PROVIDER=apertus
# Optional for Apertus (uses APERTUS_*_MODEL), defaults to gpt-5.6-luna for
# OpenAI, and required for Anthropic. Remove LLM_MODEL when switching back
# to Apertus to restore the configured local or Hugging Face model.
# LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional OpenAI reasoning effort; gpt-5.6-luna defaults to none.
# Other models use their provider default unless this is set. Supported
# efforts differ by model; invalid model/effort combinations fail explicitly.
# OPENAI_REASONING_EFFORT=none
# Optional common overrides. Apertus otherwise keeps its APERTUS_* limits;
# cloud defaults: timeout 120000 ms, token ceiling 4096, concurrency 1.
# Each planner stage may reserve fewer output tokens than this ceiling.
# LLM_TIMEOUT_MS=120000
# LLM_MAX_TOKENS=4096
# LLM_MAX_CONCURRENT_REQUESTS=1
# auto uses native schemas for cloud providers and probes Apertus support.
# strict-json disables provider grammar; application validation stays enabled.
# LLM_STRUCTURED_OUTPUT=auto
# Optional verified context capacity (input plus output reserve).
# LLM_CONTEXT_TOKENS=8192

# Server-only. local | huggingface. Restart Next.js after changing.
APERTUS_PROVIDER=local
# mlx | ollama | llamacpp (when local)
# llama.cpp serves a GGUF and uses its server alias as APERTUS_LOCAL_MODEL.
# See deploy/raspberry-pi for the pinned v1.5 Q4_K_M configuration.
APERTUS_LOCAL_RUNTIME=mlx
APERTUS_LOCAL_BASE_URL=http://127.0.0.1:43101/v1
APERTUS_LOCAL_MODEL=m1rkocasu/Apertus-v1.5-8B-text-MLX-mxfp4
# Set a model actually served by your HF provider, or use a dedicated endpoint.
APERTUS_HF_BASE_URL=https://router.huggingface.co/v1
APERTUS_HF_MODEL=
HF_TOKEN=
APERTUS_TIMEOUT_MS=120000
APERTUS_MAX_TOKENS=1024
APERTUS_MAX_CONCURRENT_REQUESTS=1
# auto probes actual JSON-schema behavior once; strict-json skips the probe.
APERTUS_STRUCTURED_OUTPUT=auto
# Optional: set only to the verified context capacity of the served model.
# APERTUS_CONTEXT_TOKENS=8192

# apertus | hybrid (optional decision shortlist selection only when ambiguous)
PLANNER_MODE=hybrid
# optional preserves legacy selection; required-laya requires actual Laya and Apertus
# for component composition, including otherwise unambiguous requests.
COMPOSITION_DECISION_POLICY=optional
# Required local composition: DECISION_TIMEOUT_MS=20000 (cold MLX inference).
PLANNER_MAX_CONCURRENT_REQUESTS=1
# Total generation budget; maximum 600000 ms.
# Defaults: 120000 ms for optional selection; 240000 for required-laya.
# PLANNER_TIMEOUT_MS=120000
# Decision model selection is independent of LLM_PROVIDER. Restart after changing.
DECISION_PROVIDER=laya
# Jev uses the TypeSafe hosted API; keep this key server-only.
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.13.0
# Common overrides; unset values preserve the LAYA_* settings for local Laya.
# DECISION_TIMEOUT_MS=3000
# Legacy validation setting; capability selection uses CREATION_ACCEPTANCE_GATE.
# DECISION_ACCEPTANCE_GATE=0.9
# DECISION_CREATION_ACCEPTANCE_GATE=0.75
# Additional confidence gate: Jev defaults to 0.75, Laya to 0 (disabled).
# These starting thresholds need calibration on your lesson requests.
# DECISION_CONFIDENCE_GATE=0.75
LAYA_BASE_URL=http://127.0.0.1:43102
# Selection budget only; the remaining total budget is shared by LLM calls.
LAYA_TIMEOUT_MS=3000
# Legacy validation setting; capability selection uses CREATION_ACCEPTANCE_GATE.
LAYA_ACCEPTANCE_GATE=0.9

# Optional ambiguous creation selection; membership and confidence are checked.
LAYA_CREATION_ACCEPTANCE_GATE=0.75
# Local-only read-only diagnostics (disabled in production).
PLANNER_DIAGNOSTICS=false
NEXT_PUBLIC_EXPERIMENT_DIAGNOSTICS=false

# Server-only database and authentication configuration. Never use NEXT_PUBLIC_*.
# Publishing requires Atlas or a replica set (for example append ?replicaSet=rs0).
# Standalone MongoDB supports private saves only.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=apertus
# Generate a unique secret for your environment; do not commit the real value.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:43100
# Google OAuth callback: http://localhost:43100/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional composer repair memory; disabled offline. Restart after changing.
REPAIR_MEMORY_MODE=off
# Runtime role: SELECT lessons and INSERT episodes, not schema-owner privileges.
REPAIR_MEMORY_DATABASE_URL=
# Privileged credentials are for the operational command, never the web deployment.
REPAIR_MEMORY_MIGRATION_DATABASE_URL=
REPAIR_MEMORY_WORKER_DATABASE_URL=
REPAIR_MEMORY_ADMIN_DATABASE_URL=
# OpenAI-compatible POST /v1/embeddings. This release requires 384 dimensions.
# Example model: sentence-transformers/all-MiniLM-L6-v2, served locally.
REPAIR_MEMORY_EMBEDDING_URL=
REPAIR_MEMORY_EMBEDDING_MODEL=
# Pin the actual deployed weights/revision; changing it excludes old embeddings.
REPAIR_MEMORY_EMBEDDING_REVISION=
REPAIR_MEMORY_EMBEDDING_KEY=
REPAIR_MEMORY_REVIEWER=
