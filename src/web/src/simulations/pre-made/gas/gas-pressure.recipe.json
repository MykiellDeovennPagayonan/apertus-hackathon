{
  "recipeVersion": 1,
  "id": "prebuilt/prefabs-AuthoredGasContainer",
  "version": 1,
  "title": "Gas Pressure",
  "description": "One independent container with one gas sample, properties and pressure output.",
  "tags": ["physical", "gas", "lab"],
  "document": {
    "formatVersion": 3,
    "nodes": [
      {
        "id": "model",
        "definition": "prefabs/AuthoredGasContainer",
        "version": 1,
        "label": "Gas container",
        "scope": "scope/lab",
        "configuration": {
          "kind": "gas",
          "label": "Gas container",
          "color": "#285e56",
          "display": {
            "x": 0,
            "y": 0,
            "width": 100,
            "height": 48
          },
          "inputs": {
            "amount": 1,
            "temperature": 300,
            "volume": 1,
            "playing": true
          },
          "particles": true
        }
      },
      {
        "id": "canvas",
        "definition": "canvases/physical",
        "version": 1,
        "label": "2D physical canvas",
        "scope": "scope/lab",
        "configuration": {
          "xMin": 0,
          "xMax": 100,
          "yMin": 0,
          "yMax": 48,
          "grid": false,
          "snap": 0.5
        }
      },
      {
        "id": "control/set:volume",
        "definition": "controls/Slider",
        "version": 1,
        "label": "Slider",
        "scope": "scope/lab",
        "configuration": {
          "label": "Volume",
          "mode": "immediate",
          "initial": "{\"value\":1}"
        }
      },
      {
        "id": "display/pressureKPa",
        "definition": "displays/Readout",
        "version": 1,
        "label": "Readout",
        "scope": "scope/lab",
        "configuration": {
          "label": "Pressure",
          "precision": 2
        }
      }
    ],
    "connections": [
      {
        "id": "link/canvas",
        "kind": "attachment",
        "from": {
          "node": "model",
          "port": "appearance"
        },
        "to": {
          "node": "canvas",
          "port": "objects"
        }
      },
      {
        "id": "link/control/set:volume",
        "kind": "command",
        "from": {
          "node": "control/set:volume",
          "port": "submit"
        },
        "to": {
          "node": "model",
          "port": "set:volume"
        }
      },
      {
        "id": "link/output/pressureKPa",
        "kind": "value",
        "from": {
          "node": "model",
          "port": "pressureKPa"
        },
        "to": {
          "node": "display/pressureKPa",
          "port": "value"
        }
      }
    ],
    "resources": [],
    "scopes": [
      {
        "id": "scope/lab",
        "label": "Gas container"
      }
    ],
    "groups": [],
    "layout": {
      "id": "layout/root",
      "kind": "stack",
      "label": "",
      "gap": 16,
      "columns": 2,
      "children": [
        {
          "id": "layout/canvas",
          "kind": "stack",
          "label": "",
          "gap": 16,
          "columns": 2,
          "children": [],
          "node": "canvas"
        },
        {
          "id": "layout/display/pressureKPa",
          "kind": "stack",
          "label": "",
          "gap": 16,
          "columns": 2,
          "children": [],
          "node": "display/pressureKPa"
        },
        {
          "id": "layout/control/set:volume",
          "kind": "stack",
          "label": "",
          "gap": 16,
          "columns": 2,
          "children": [],
          "node": "control/set:volume"
        }
      ]
    },
    "lesson": {
      "title": "Gas pressure",
      "instruction": "Change the volume. Watch the pressure respond.",
      "explanation": "Less volume means more pressure. More volume means less pressure. Temperature and the amount of gas stay fixed. Particles illustrate an ideal gas."
    },
    "editor": {
      "positions": {},
      "zoom": 1
    }
  },
  "nested": [],
  "parameters": [
