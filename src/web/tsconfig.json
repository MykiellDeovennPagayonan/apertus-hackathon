{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-agent-a-live/types/**/*.ts",
    ".next-agent-a-live/dev/types/**/*.ts",
    ".next-slope-square/types/**/*.ts",
    ".next-slope-square/dev/types/**/*.ts",
    ".next-agent-c/types/**/*.ts",
    ".next-agent-c/dev/types/**/*.ts",
    ".next-agent-b/types/**/*.ts",
    ".next-agent-b/dev/types/**/*.ts",
    ".next-composition/types/**/*.ts",
    ".next-composition/dev/types/**/*.ts",
    ".next-graph/types/**/*.ts",
    ".next-graph/dev/types/**/*.ts",
    ".next-parity/types/**/*.ts",
    ".next-parity/dev/types/**/*.ts",
    ".next-parity-build/types/**/*.ts",
    ".next-parity-build/dev/types/**/*.ts",
    ".next-drawing-tools/types/**/*.ts",
    ".next-drawing-tools/dev/types/**/*.ts",
    ".next-realistic-validation/types/**/*.ts",
    ".next-realistic-validation/dev/types/**/*.ts",
    ".next-realistic-build/types/**/*.ts",
    ".next-realistic-build/dev/types/**/*.ts",
    ".next-science-validation/types/**/*.ts",
    ".next-science-validation/dev/types/**/*.ts",
    ".next-science-build/types/**/*.ts",
    ".next-science-build/dev/types/**/*.ts",
    ".next-028/types/**/*.ts",
    ".next-028/dev/types/**/*.ts",
    ".next-028-build/types/**/*.ts",
    ".next-028-build/dev/types/**/*.ts",
    ".next-a3/types/**/*.ts",
    ".next-a3/dev/types/**/*.ts",
    ".next-028-fixes/types/**/*.ts",
    ".next-028-fixes/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
